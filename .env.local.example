# Copie este arquivo para .env.local (que não vai pro Git) e preencha.

# Chave da API da Anthropic — console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Preenchidos quando a integração Supabase for conectada ao projeto na Vercel
# (Vercel → seu projeto → Storage → Supabase → Connect)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
